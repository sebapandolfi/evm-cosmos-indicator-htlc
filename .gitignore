# Dependencies
node_modules/
package-lock.json

# Build artifacts
artifacts/
cache/
target/

# CosmWasm build artifacts (keep .wasm in artifacts/ if needed)
cosmwasm-contract/target/

# Environment
.env
.env.local

# State files (generated during testing)
htlc-state*.json
*-deployment*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
artifacts-local/

# LaTeX build artifacts
*.aux
*.out
*.synctex.gz

# TLA+ / TLC: the jar is downloaded separately; error traces and
# fingerprint state are regenerated on every run
formal/tla2tools.jar
*_TTrace_*
formal/**/metadir_*/

# TLC logs are published results, not build noise
!formal/logs/*.log
!formal/v1/logs/*.log
